function(aeg_add_math_library target force_scalar)
    add_library(${target} STATIC ${aeg_math_sources})
    target_include_directories(${target} PUBLIC "${CMAKE_CURRENT_SOURCE_DIR}/public")
    target_compile_features(${target} PUBLIC cxx_std_23)
    if(force_scalar)
        target_compile_definitions(${target} PRIVATE AEG_MATH_FORCE_SCALAR=1)
    endif()
    if(MSVC)
        target_compile_options(${target} PRIVATE /W4 /fp:precise)
    else()
        target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic -fno-fast-math)
    endif()
endfunction()
