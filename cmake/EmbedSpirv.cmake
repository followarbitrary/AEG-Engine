cmake_minimum_required(VERSION 3.25)

foreach(argument INPUT OUTPUT SYMBOL)
    if(NOT DEFINED ${argument} OR "${${argument}}" STREQUAL "")
        message(FATAL_ERROR "EmbedSpirv requires -D${argument}=...")
    endif()
endforeach()

if(NOT SYMBOL MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
    message(FATAL_ERROR "EmbedSpirv SYMBOL must be a valid C++ identifier: ${SYMBOL}")
endif()
if(NOT EXISTS "${INPUT}" OR IS_DIRECTORY "${INPUT}")
    message(FATAL_ERROR "EmbedSpirv INPUT must be an existing SPIR-V file: ${INPUT}")
endif()
file(SIZE "${INPUT}" byte_count)
if(byte_count LESS 20)
    message(FATAL_ERROR "EmbedSpirv INPUT must contain at least the 20-byte SPIR-V header")
endif()
math(EXPR remainder "${byte_count} % 4")
if(NOT remainder EQUAL 0)
    message(FATAL_ERROR "EmbedSpirv INPUT size must be a multiple of four bytes")
endif()
file(READ "${INPUT}" spirv_hex HEX)
string(SUBSTRING "${spirv_hex}" 0 8 magic)
if(NOT magic STREQUAL "03022307")
    message(FATAL_ERROR "EmbedSpirv INPUT must have little-endian SPIR-V magic 0x07230203")
endif()

math(EXPR word_count "${byte_count} / 4")
set(header "#pragma once\n\n#include <array>\n#include <cstdint>\n\nnamespace aeg::embedded_shaders {\n\ninline constexpr std::array<std::uint32_t, ${word_count}> ${SYMBOL} = {\n")
string(REGEX MATCHALL "........" words "${spirv_hex}")
set(column 0)
foreach(word IN LISTS words)
    # SPIR-V files are little endian; construct each numeric word explicitly so
    # generation is independent of the host's byte order.
    string(SUBSTRING "${word}" 0 2 byte0)
    string(SUBSTRING "${word}" 2 2 byte1)
    string(SUBSTRING "${word}" 4 2 byte2)
    string(SUBSTRING "${word}" 6 2 byte3)
    if(column EQUAL 0)
        string(APPEND header "    ")
    else()
        string(APPEND header " ")
    endif()
    string(APPEND header "0x${byte3}${byte2}${byte1}${byte0}u,")
    math(EXPR column "(${column} + 1) % 8")
    if(column EQUAL 0)
        string(APPEND header "\n")
    endif()
endforeach()
if(NOT column EQUAL 0)
    string(APPEND header "\n")
endif()
string(APPEND header "};\n\n} // namespace aeg::embedded_shaders\n")

if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" existing_header)
    if(existing_header STREQUAL header)
        return()
    endif()
endif()
get_filename_component(output_directory "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
file(WRITE "${OUTPUT}" "${header}")
