if(NOT EXISTS "${EDITOR}")
    message(FATAL_ERROR "Tone mapping CLI requires the built editor")
endif()
function(aeg_check_tone_cli expected diagnostic)
    execute_process(COMMAND "${EDITOR}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors ENCODING UTF-8 TIMEOUT 10)
    if(NOT result STREQUAL "${expected}")
        message(FATAL_ERROR "Unexpected CLI exit ${result}: ${ARGN}\n${output}\n${errors}")
    endif()
    if(NOT "${output}${errors}" MATCHES "${diagnostic}")
        message(FATAL_ERROR "Missing CLI diagnostic ${diagnostic}: ${ARGN}\n${output}\n${errors}")
    endif()
endfunction()
aeg_check_tone_cli(0 "--tone-mapper" --help)
aeg_check_tone_cli(0 "--exposure" --tone-mapper linear --exposure -12 --help)
aeg_check_tone_cli(0 "--exposure" --tone-mapper aces --exposure 12 --help)
aeg_check_tone_cli(0 "--tone-mapper" --tone-mapper agx --exposure 0 --help)
aeg_check_tone_cli(0 "--exposure" --exposure -1.25 --help)
aeg_check_tone_cli(0 "--exposure" --exposure +1 --help)
aeg_check_tone_cli(0 "--exposure" --exposure +12 --help)
aeg_check_tone_cli(1 "--tone-mapper" --tone-mapper invalid --help)
aeg_check_tone_cli(1 "--tone-mapper" --tone-mapper)
foreach(value -13 13 nan inf 1oops + +-1 ++1)
    aeg_check_tone_cli(1 "--exposure" --exposure "${value}" --help)
endforeach()
aeg_check_tone_cli(1 "--exposure" --exposure)
