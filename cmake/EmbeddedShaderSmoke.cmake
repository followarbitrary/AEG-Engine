cmake_minimum_required(VERSION 3.25)

foreach(parameter EDITOR CHECKER MODEL WORK_DIR)
    if(NOT DEFINED ${parameter} OR "${${parameter}}" STREQUAL "")
        message(FATAL_ERROR "Embedded shader deployment smoke requires ${parameter}")
    endif()
    if(NOT IS_ABSOLUTE "${${parameter}}")
        message(FATAL_ERROR "${parameter} must be absolute: ${${parameter}}")
    endif()
endforeach()
foreach(parameter EDITOR CHECKER MODEL)
    if(NOT EXISTS "${${parameter}}" OR IS_DIRECTORY "${${parameter}}")
        message(FATAL_ERROR "${parameter} is missing: ${${parameter}}")
    endif()
endforeach()

# Each run has a fresh deployment directory, retained with captures and logs.
# Only the executable and runtime DLLs are copied; models stay at their source.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(stage "${WORK_DIR}/deployment-${run_id}")
if(EXISTS "${stage}")
    message(FATAL_ERROR "Deployment smoke directory already exists: ${stage}")
endif()
file(MAKE_DIRECTORY "${stage}")
get_filename_component(editor_directory "${EDITOR}" DIRECTORY)
get_filename_component(editor_name "${EDITOR}" NAME)
file(COPY "${EDITOR}" DESTINATION "${stage}")
file(GLOB runtime_dlls LIST_DIRECTORIES FALSE "${editor_directory}/*.dll" "${editor_directory}/*.DLL")
list(REMOVE_DUPLICATES runtime_dlls)
if(runtime_dlls)
    file(COPY ${runtime_dlls} DESTINATION "${stage}")
endif()
set(deployed_editor "${stage}/${editor_name}")
message(STATUS "Embedded shader deployment evidence: ${stage}")

function(require_no_shader_resources)
    file(GLOB_RECURSE staged_entries LIST_DIRECTORIES TRUE "${stage}/*")
    foreach(entry IN LISTS staged_entries)
        get_filename_component(name "${entry}" NAME)
        string(TOLOWER "${name}" name_lower)
        if(name_lower STREQUAL "shaders" OR name_lower MATCHES "\\.spv(\\.hpp)?$")
            message(FATAL_ERROR "Deployment must have no shader resources: ${entry}")
        endif()
    endforeach()
    if(EXISTS "${stage}/assets" OR EXISTS "${stage}/models")
        message(FATAL_ERROR "Deployment unexpectedly contains copied assets/models")
    endif()
endfunction()

function(run_capture name frames)
    require_no_shader_resources()
    set(capture "${stage}/${name}.ppm")
    # With no bundled font, EditorFont selects the installed Windows Chinese font.
    execute_process(COMMAND "${deployed_editor}" --hidden --frames "${frames}"
        --model "${MODEL}" --capture "${capture}" ${ARGN}
        WORKING_DIRECTORY "${stage}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 90)
    file(WRITE "${stage}/${name}.stdout.log" "${output}")
    file(WRITE "${stage}/${name}.stderr.log" "${errors}")
    set(diagnostics "${output}\n${errors}")
    message(STATUS "${name}:\n${diagnostics}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Deployed ${name} failed: ${result}\n${diagnostics}")
    endif()
    if(diagnostics MATCHES "\\[Vulkan error\\]")
        message(FATAL_ERROR "Deployed ${name} reported a Vulkan error (including teardown):\n${diagnostics}")
    endif()
    if(NOT diagnostics MATCHES "Validation errors: 0([\r\n]|$)")
        message(FATAL_ERROR "Deployed ${name} has no zero-validation result:\n${diagnostics}")
    endif()
    require_no_shader_resources()
    execute_process(COMMAND "${CHECKER}" "${capture}"
        WORKING_DIRECTORY "${stage}"
        RESULT_VARIABLE check OUTPUT_VARIABLE report ERROR_VARIABLE failure TIMEOUT 15)
    file(WRITE "${stage}/${name}.check.log" "result: ${check}\n${report}\n${failure}")
    message(STATUS "${report}")
    if(NOT "${check}" STREQUAL "0")
        message(FATAL_ERROR "Deployed ${name} capture is missing or blank:\n${report}\n${failure}")
    endif()
endfunction()

run_capture(msaa-fxaa 16 --msaa 4 --fxaa)
run_capture(taa-fxaa 32 --taa --fxaa)
