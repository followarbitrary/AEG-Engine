if(NOT EXISTS "${EDITOR}")
    message(FATAL_ERROR "Model-viewer acceptance: executable is missing (feature not implemented yet)")
endif()
set(arguments --hidden --frames 12 --capture "${CAPTURE}")
if(DEFINED MODEL)
    list(APPEND arguments --model "${MODEL}")
endif()
execute_process(COMMAND "${EDITOR}" ${arguments}
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 60)
message(STATUS "${output}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "GPU smoke failed: ${result}\n${errors}")
endif()
if(errors MATCHES "\\[Vulkan error\\]")
    message(FATAL_ERROR "Vulkan validation reported an error (including teardown):\n${errors}")
endif()
if(NOT output MATCHES "Validation errors: 0")
    message(FATAL_ERROR "Missing successful validation result\n${output}\n${errors}")
endif()
set(check_arguments "${CAPTURE}")
if(EXPECT_BLANK)
    list(APPEND check_arguments --expect-blank)
endif()
execute_process(COMMAND "${CHECKER}" ${check_arguments} RESULT_VARIABLE check OUTPUT_VARIABLE report ERROR_VARIABLE failure)
message(STATUS "${report}")
if(NOT check EQUAL 0)
    message(FATAL_ERROR "${failure}")
endif()
